<resources>
    <style name="Base.Theme.Cheqmate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorTertiary">@color/black</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:colorControlActivated">@color/black</item>
        <item name="android:colorAccent">@color/black</item>
        <item name="android:textColorHighlight">#33000000</item>
    </style>

    <style name="Theme.Cheqmate" parent="Base.Theme.Cheqmate" />

    <style name="Widget.Cheqmate.TextInputLayout.Auth" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/auth_input_bg</item>
        <item name="boxStrokeColor">@color/black</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/dark_gray</item>
        <item name="android:textColorHint">@color/dark_gray</item>
        <item name="endIconTint">@color/black</item>
    </style>

    <style name="Widget.Cheqmate.Button.ChequeItem" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/divider_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
</resources>
