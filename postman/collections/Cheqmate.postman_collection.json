        {
          "name": "Get My Groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const groups = pm.response.json();",
                  "pm.test('Response is array', function () {",
                  "    pm.expect(groups).to.be.an('array');",
                  "});",
                  "const groupName = pm.collectionVariables.get('groupName');",
                  "const found = groups.find(g => g.name === groupName);",
                  "pm.test('Created group is in list', function () {",
                  "    pm.expect(found, 'group not found').to.not.be.undefined;",
                  "    pm.expect(found.id).to.be.a('number');",
                  "});",
                  "if (found) {",
                  "    pm.collectionVariables.set('groupId', found.id);",
                  "    pm.environment.set('groupId', found.id);",
                  "}"
